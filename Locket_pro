/**
 * ==============================================================================
 * Tên script: Locket Master Clean Gold & Filter Unlock (Full Offline, No Auth, 2M Video)
 * Tương thích: Quantumult X, Surge, Loon, Shadowrocket, Stash
 * ==============================================================================
 */

// 1. CẤU HÌNH THỜI LƯỢNG & CHẤT LƯỢNG (2 Phút / 120 Giây)
const VIDEO_DURATION_SEC = 120.0;
const VIDEO_DURATION_STR = "120.0";

// 2. XỬ LÝ REQUEST ($response chưa tồn tại) -> Xóa bỏ header cache
if (typeof $response === 'undefined') {
  let reqHeaders = Object.assign({}, ($request && $request.headers) || {});
  const headersToRemove = ['if-none-match', 'if-modified-since', 'x-revenuecat-etag', 'x-goog-if-none-match'];
  for (let k of Object.keys(reqHeaders)) {
    if (headersToRemove.includes(k.toLowerCase())) {
      delete reqHeaders[k];
    }
  }
  $done({ headers: reqHeaders });
}

// 3. XỬ LÝ RESPONSE ($response đã có dữ liệu) -> Mở khóa toàn diện Gold & Filter
else {
  const reqUrl = (typeof $request !== 'undefined' && $request.url) ? $request.url : '';
  let body = $response.body;
  let status = $response.status || $response.statusCode || 200;

  // Luôn trả về thành công tuyệt đối cho mọi request dùng Filter / PTB / Ảnh
  if (reqUrl.includes('generateFilteredImage') || reqUrl.includes('filter') || reqUrl.includes('ptb')) {
    $done({
      status: 200,
      headers: { 'content-type': 'application/json; charset=utf-8' },
      body: JSON.stringify({
        result: {
          status: 200,
          is_gold: true,
          is_locked: false,
          requires_gold: false,
          unlocked: true,
          can_use_filters: true,
          filter_access: true
        }
      })
    });
    return;
  }

  if (body && typeof body === 'string') {
    try {
      let obj = JSON.parse(body);

      // Tiêm gói vĩnh viễn RevenueCat để kích hoạt trạng thái Gold vĩnh viễn trên app
      if (obj.subscriber || reqUrl.includes('subscriptions') || reqUrl.includes('entitlements') || reqUrl.includes('v1/subscribers')) {
        const subscriptionData = {
          auto_resume_date: null,
          display_name: "locket_1600_1y",
          is_sandbox: false,
          ownership_type: "PURCHASED",
          period_type: "normal",
          expires_date: "9999-01-09T10:10:14Z",
          original_purchase_date: "2005-01-09T10:10:15Z",
          purchase_date: "2005-01-09T10:10:14Z",
          store: "app_store",
          store_transaction_id: "2000001108724193"
        };
        const entitlementData = {
          purchase_date: "2005-01-09T10:10:14Z",
          original_purchase_date: "2005-01-09T10:10:15Z",
          product_identifier: "locket_1600_1y",
          ownership_type: "PURCHASED",
          store: "app_store",
          expires_date: "9999-01-09T10:10:14Z"
        };

        obj.subscriber = obj.subscriber || {};
        obj.subscriber.subscriptions = obj.subscriber.subscriptions || {};
        obj.subscriber.entitlements = obj.subscriber.entitlements || {};

        const unlockKeys = [
          "locket_1600_1y", "Gold", "gold", "pro", "locket_gold", 
          "holiday_effects", "camera_filters", "camera_filter", 
          "ai_filters", "ai_filter", "filters", "filter", "unlimited_friends"
        ];
        unlockKeys.forEach(k => {
          obj.subscriber.subscriptions[k] = subscriptionData;
          obj.subscriber.entitlements[k] = entitlementData;
        });
      }

      // Xử lý Remote Config / App Config
      if (obj.entries && typeof obj.entries === 'object') {
        obj.entries["max_video_duration"] = VIDEO_DURATION_STR;
        obj.entries["video_max_duration"] = VIDEO_DURATION_STR;
        obj.entries["camera_roll_max_duration"] = VIDEO_DURATION_STR;
        obj.entries["camera_roll_video_max_duration"] = VIDEO_DURATION_STR;
        obj.entries["is_gold"] = "true";
        obj.entries["has_gold"] = "true";
        obj.entries["require_gold_for_filters"] = "false";
        obj.entries["requires_gold_for_filters"] = "false";
      }

      // Hàm đệ quy bật quyền Gold, mở khóa bộ lọc và xử lý ảnh siêu nét
      function deepUnlockAndClean(node) {
        if (!node || typeof node !== 'object') return;
        if (Array.isArray(node)) {
          for (let i = 0; i < node.length; i++) {
            deepUnlockAndClean(node[i]);
          }
          return;
        }

        // Ép huy hiệu và trạng thái Gold cho mọi đối tượng
        node.badge = 'locket_gold';
        node.badge_tier = 'gold';
        node.is_gold = true;
        node.has_gold = true;
        node.gold = true;
        node.gold_subscription = true;
        node.has_gold_subscription = true;
        node.tier = 'gold';
        node.subscription_status = 'active';

        // Tắt toàn bộ cờ khóa, paywall, token lỗi
        const falseProps = [
          'is_locked', 'locked', 'requires_gold', 'require_gold', 
          'gold_only', 'is_gold_only', 'paywall', 'show_paywall', 
          'blurred', 'is_blurred', 'needs_gold', 'token_locked', 'invalid_token'
        ];
        falseProps.forEach(p => { if (p in node) node[p] = false; });

        // Bật toàn bộ cờ tự do sử dụng tính năng và bộ lọc
        const trueProps = [
          'can_view', 'unlocked', 'is_unlocked', 'is_free', 'free', 
          'can_use_filter', 'allowed', 'can_use_filters', 'can_use_gold_features',
          'can_generate_filtered_image', 'can_create_filtered_image', 'has_ai_access', 'filter_access'
        ];
        trueProps.forEach(p => { if (p in node) node[p] = true; });

        // Mở rộng giới hạn thời lượng video
        const durationProps = ['max_duration', 'maxDuration', 'gold_max_duration', 'video_max_duration', 'camera_roll_max_duration'];
        durationProps.forEach(p => {
          if (p in node) node[p] = VIDEO_DURATION_SEC;
        });

        // Bỏ làm mờ ảnh, trả về link gốc
        const unblurredUrl = node.unblurred_url || node.unlocked_url || node.result_url || node.image_url || node.url;
        if (unblurredUrl && typeof unblurredUrl === 'string' && unblurredUrl.startsWith('http')) {
          if ('blurred_url' in node) node.blurred_url = unblurredUrl;
          if ('blurred_image_url' in node) node.blurred_image_url = unblurredUrl;
          if ('preview_url' in node) node.preview_url = unblurredUrl;
        }

        for (let key of Object.keys(node)) {
          deepUnlockAndClean(node[key]);
        }
      }

      deepUnlockAndClean(obj);
      body = JSON.stringify(obj);
    } catch (err) {}
  }

  let respHeaders = Object.assign({}, ($response && $response.headers) || {});
  delete respHeaders['Content-Encoding'];
  delete respHeaders['content-encoding'];
  delete respHeaders['Content-Length'];
  delete respHeaders['content-length'];
  delete respHeaders['Transfer-Encoding'];
  delete respHeaders['transfer-encoding'];
  respHeaders['content-type'] = 'application/json; charset=utf-8';

  $done({
    status: (status === 402 || status === 403 || status === 400) ? 200 : status,
    headers: respHeaders,
    body
  });
}
